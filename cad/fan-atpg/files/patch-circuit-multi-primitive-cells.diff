+			}
 		}
 	}
 	if ((int)top->getNCell() > 0)
 	{
-		circuitLvl_ = circuitGates_[cellIndexToGateIndex_[top->getNCell() - 1]].numLevel_ + 2;
+		circuitLvl_ = maxCombLvl + 2;
 	}
