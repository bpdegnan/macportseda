# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           eda-github 1.0
PortGroup           stub 1.0

name                eda-ngspice
# VERSION TRACKS THE DEFAULT THIS STUB POINTS AT, deliberately. Before the split
# this port WAS the ngspice build and carried version 46, so a stub numbered
# (say) 1.0 would sort BELOW the installed 46 and MacPorts would refuse the
# upgrade as a downgrade. Keeping version == the default version makes the
# migration a normal same-version/higher-revision upgrade, and stays monotonic
# when the default later moves to 47.
version             46
revision            1

categories          cad science
license             BSD
supported_archs     noarch
platforms           any
maintainers         {icanalytica.com:degnan @bpdegnan} openmaintainer
homepage            https://ngspice.sourceforge.io/

description         Metaport: the tree's pinned ngspice (default version)
long_description    Compatibility metaport. Up to 2026-08 this name WAS the \
                    ngspice 46 build, and the port was then split so that several \
                    releases can coexist, each in its own private prefix \
                    (${prefix}/libexec/eda/ngspice<version>) with `port select` \
                    choosing the active one. This stub now just pulls the \
                    tree's default version, so `port install eda-ngspice`, the \
                    eda-icall metaport and existing installs keep working. \
                    Install eda-ngspice47 as well to have both, and switch with \
                    'sudo port select --set eda-ngspice eda-ngspice47'.

# DEFAULT = 46, deliberately: it is the version this tree has actually validated
# (the openvaf -> OSDI -> ngspice chain and the kicad simulator both verified
# against it). 47 is packaged and coexists, but a fresh `port install eda-icall`
# should land on the known-good simulator, not the newest one. Move this to 47
# once 47 has been through the same checks.
depends_lib-append  port:eda-ngspice46

notes "
eda-ngspice is now a metaport. The real builds are versioned and coexist:

  eda-ngspice46   -> ${prefix}/libexec/eda/ngspice46   (validated)
  eda-ngspice47   -> ${prefix}/libexec/eda/ngspice47

Each is always callable by its versioned name (eda-ngspice46, eda-ngspice47).
Pick which one answers to \`eda-ngspice\` -- and which libngspice kicad
dlopens -- with:

  sudo port select --set eda-ngspice eda-ngspice46
  port select --list eda-ngspice

NOTE: nothing is selected automatically. Until you run the command above there
is no ${prefix}/bin/eda-ngspice and no ${prefix}/libexec/eda/lib/libngspice.dylib,
so kicad will not find a simulator.
"

livecheck.type      none
