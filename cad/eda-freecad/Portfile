description         FreeCAD parametric 3D CAD (current release, private prefix)
long_description    FreeCAD is a general-purpose parametric 3D CAD modeller. \
                    Packaged here as eda-freecad because it is used for the \
                    mechanical enclosures around the PCBs in this flow (via the \
                    KiCad StepUp workbench, installed through FreeCAD's Addon \
                    Manager), and because the stock MacPorts freecad port is \
                    stuck at 0.18.5 (2019) on a dead stack: qt4-mac, python310, \
                    PySide1/py-shiboken 1.2.4 and the old oce fork of \
                    OpenCASCADE. This port is FreeCAD ${version} on Qt 6, \
                    OpenCASCADE 7.9 and Coin3D 4.

homepage            https://www.freecad.org

# Upstream's official source distribution release asset (NOT the git archive --
# the asset is the sanctioned source drop). The tarball is FLAT (no top-level
# directory: .clang-format sits at the root), hence extract.mkdir.
master_sites        https://github.com/FreeCAD/FreeCAD/releases/download/${version}
distname            freecad_source_${version}
extract.mkdir       yes

# sha256 matches upstream's published freecad_source_1.1.3.tar.gz-SHA256.txt
checksums           rmd160  39bc3eeaa58e928f1e50f907c63480bd53bae32d \
                    sha256  4813a5cd12be05253cd40cc1dc3995b1aaa1aa06f7dfbc15c7ffa99c1c3903b7 \
                    size    98193618

# Python target. MUST match eda-pivy: FreeCAD's SetupPivy imports pivy with THIS
# interpreter at configure time, and FreeCAD hard-errors unless the Coin version
# it links equals the Coin version pivy reports. Change both ports together.
set py_ver          3.12
set py_branch       312
set py_framework    ${prefix}/Library/Frameworks/Python.framework/Versions/${py_ver}

set edaprefix       ${prefix}/libexec/eda
# Keep in step with the eda-coin port (installs to lib/cmake/Coin-<version>).
set coin_version    4.0.10
# Split out for the COIN3D_*_VERSION configure args below (see the note there):
# single source of truth, so bumping coin_version updates all of them.
set coin_major      [lindex [split ${coin_version} .] 0]
set coin_minor      [lindex [split ${coin_version} .] 1]
set coin_micro      [lindex [split ${coin_version} .] 2]

cmake.install_prefix ${prefix}/libexec/freecad

# ---- PLATFORM GATE ----------------------------------------------------------
# FreeCAD ${version} needs a Qt 6.7-era Qt plus a matching PySide6/Shiboken6.
# The qt6_info PortGroup only offers those from os.major 21 (macOS 12 Monterey)
# upward -- on older systems the newest Qt 6 available is 6.4
#   qt67 {6.7 {24 23 22 21}}   qt64 {6.4 {24 23 22 21 20 19 18}}
# and py-pyside6 would try to pair PySide6 6.7.3 with Qt 6.4. So fail FAST and
# clearly on the user's older machines (10.13 / 10.15) rather than burning hours
# in a ~1M-LOC C++ build that cannot succeed. Verified target: macOS 13 and 14+.
if {${os.major} < 21} {
    known_fail          yes
    pre-fetch {
        ui_error "${subport} needs macOS 12 (Monterey) or newer."
        ui_error "This system is macOS ${macosx_version} (Darwin ${os.major}), where the"
        ui_error "newest Qt 6 MacPorts offers is 6.4 -- too old for FreeCAD ${version},"
        ui_error "which requires a Qt 6.7-era Qt with a matching PySide6/Shiboken6."
        ui_error "Nothing is installed or changed by this failure."
        return -code error "unsupported platform for ${subport}"
    }
}

# ---- macOS 13 (Ventura) and older: C++20 <source_location> ------------------
# FreeCAD's src/Base/Exception.h includes <source_location>, which libc++ only
# gained in LLVM 16. The Ventura CLT ships libc++ 15, so the build dies with
#     src/Base/Exception.h:32:10: fatal error: 'source_location' file not found
# Same class of problem as the kicad port, and the same remedy: compile with
# MacPorts clang-19 and its libc++ 19 HEADERS, while still LINKING the system
# libc++ runtime. std::source_location is header-only (it lowers to the
# __builtin_source_location compiler intrinsic), so no new runtime symbols are
# needed and we avoid two libc++ runtimes in one process -- an ABI/crash trap,
# since Qt/OCCT/VTK/PySide6 here are all built against the system libc++.
#
# GATED, NOT UNCONDITIONAL: this port is verified working on macOS 15.3 (Darwin
# 24) with the stock toolchain, and forcing clang-19 there would needlessly
# diverge from that known-good configuration. Evidence for the threshold:
# Darwin 22 lacks the header (build failure above), Darwin 24 builds clean.
if {${os.major} <= 22} {
    configure.compiler        macports-clang-19
    configure.cxxflags-append -nostdinc++ \
                              -isystem ${prefix}/libexec/llvm-19/include/c++/v1
    depends_build-append      port:clang-19
}

depends_build-append \
                    port:pkgconfig

# Qt 6. FreeCAD's SetupQt.cmake requires components Core Concurrent Network Xml
# plus (with BUILD_GUI) GuiTools SvgWidgets OpenGLWidgets OpenGL PrintSupport
# Svg UiTools Widgets LinguistTools. With BUILD_WEB=OFF below, NO WebEngine.
qt6.depends_lib-append \
                    qtbase \
                    qtsvg \
                    qttools

depends_lib-append  port:opencascade \
                    port:eda-coin \
                    port:eda-pivy \
                    port:eigen3 \
                    port:xercesc3 \
                    port:yaml-cpp \
                    port:pybind11 \
                    port:libfmt11 \
                    port:vtk \
                    port:libmed \
                    port:freetype \
                    port:zlib \
                    port:python${py_branch} \
                    port:py${py_branch}-pyside6 \
                    port:py${py_branch}-matplotlib

configure.args-append \
    -DFREECAD_QT_MAJOR_VERSION=6 \
    -DPython3_EXECUTABLE=${py_framework}/bin/python${py_ver} \
    -DCoin_DIR=${edaprefix}/lib/cmake/Coin-${coin_version} \
    -DCOIN3D_VERSION=${coin_version} \
    -DCOIN3D_MAJOR_VERSION=${coin_major} \
    -DCOIN3D_MINOR_VERSION=${coin_minor} \
    -DCOIN3D_MICRO_VERSION=${coin_micro} \
    -DBUILD_GUI=ON \
    -DBUILD_WEB=OFF \
    -DBUILD_FEM=ON \
    -DBUILD_FEM_NETGEN=OFF \
    -DBUILD_ADDONMGR=ON \
    -DBUILD_SANDBOX=OFF \
    -DBUILD_TEMPLATE=OFF \
    -DBUILD_DESIGNER_PLUGIN=OFF \
    -DBUILD_TEST=OFF \
    -DENABLE_DEVELOPER_TESTS=OFF \
    -DFREECAD_CREATE_MAC_APP=OFF \
    -DFREECAD_USE_EXTERNAL_FMT=ON \
    -Dfmt_DIR=${prefix}/lib/libfmt11/cmake/fmt \
    -DBoost_DIR=${prefix}/libexec/boost/1.81/lib/cmake/Boost-1.81.0 \
    -DBOOST_ROOT=${prefix}/libexec/boost/1.81 \
    -DBoost_NO_SYSTEM_PATHS=ON

# WHY THESE MATTER (each one was established by reading FreeCAD's cMake/ helpers):
#
# BUILD_WEB=OFF -- defaults ON and pulls PySide6.QtWebEngineWidgets. The tree's
#   py-pyside6 is deliberately built WITHOUT +addonmodules, because the addon set
#   drags in qt67-qtwebengine (a full Chromium build) plus llvm-22/clang-22, i.e.
#   38 extra ports. FreeCAD needs only base PySide6 modules, so drop the Web module.
#
# fmt_DIR + FREECAD_USE_EXTERNAL_FMT -- SetupLibFmt.cmake does find_package(fmt
#   QUIET) and, if that misses, PINGS github.com and FetchContent-downloads fmt
#   11.1.4 mid-build. MacPorts installs fmt's CMake config into a VERSIONED subdir
#   (${prefix}/lib/libfmt11/cmake/fmt) that is off CMake's default search path, so
#   find_package would miss it -- exactly the defect the OpenSTA port hit. Point
#   fmt_DIR at it so nothing is fetched at build time. Update the path if the
#   libfmt dependency version changes.
#
# Coin_DIR -- Coin 4 lives in the private EDA prefix (see eda-coin); FreeCAD's
#   SetupCoin3D.cmake tries find_package(Coin CONFIG) first, so this points it there.
#
# COIN3D_*_VERSION -- works around an UPSTREAM REGEX BUG in SetupCoin3D.cmake,
#   which made the build die with "Coin3D version 4.0.1 mismatches Pivy Coin3D
#   4.0.10" even though both ARE the same Coin 4.0.10. The macro parses
#   Inventor/C/basic.h with "([0-9?])" -- a SINGLE-character class -- so a
#   two-digit COIN_MICRO_VERSION (10) captures only "1" and it computes 4.0.1.
#   Pivy's version, by contrast, is matched with a correct "([0-9]+)" and comes
#   out 4.0.10, so the equality test in SetupPivy fails. The parse is guarded by
#   IF (NOT COIN3D_VERSION), so supplying the version on the command line skips
#   the broken block entirely -- no patchfile to keep in sync. All four values
#   derive from ${coin_version} above. (FindMEDFile.cmake has the same
#   single-digit bug, but nothing compares MED's version, so it is harmless.)
#
# BUILD_ADDONMGR=ON -- this is how KiCad StepUp (the PCB->enclosure workbench
#   that motivates this port) gets installed, so it is deliberately kept.
#
# BUILD_FEM_NETGEN=OFF -- Salome SMESH is bundled under src/3rdParty and is
#   enough for FEM meshing; the external netgen 6.2 pairing is untested here.
#   Turn on later if FEM meshing needs it.
#
# port:vtk -- REQUIRED, found the hard way (configure failure, 2026-08).
#   InitializeFreeCADBuildOptions.cmake sets FREECAD_USE_SMESH=ON whenever
#   BUILD_FEM (or BUILD_MESH_PART) is on, and SetupSalomeSMESH.cmake then does a
#   find_package(VTK ... REQUIRED) -- "if we use smesh we definitely also need
#   vtk, no matter of external or internal smesh". So the BUNDLED SMESH still
#   needs an EXTERNAL VTK; BUILD_FEM_NETGEN=OFF does not avoid it. MacPorts vtk
#   is 9.6.2, which satisfies FreeCAD's preferred find_package(VTK 9) path, and
#   its config lands in ${prefix}/lib/cmake/vtk-9.6 -- that matches CMake's
#   default lib/cmake/<name>* glob, so no -DVTK_DIR pin is needed (contrast
#   libfmt11, whose lib/libfmt11/cmake/fmt layout does need one).
#
# port:libmed -- ALSO REQUIRED, and it IS in MacPorts (science/devel, 4.1.1),
#   contrary to the earlier assumption that MED was unavailable and FEM MED
#   support would simply be skipped. There is no skip: with the BUNDLED SMESH
#   (FREECAD_USE_EXTERNAL_SMESH=OFF), SetupSalomeSMESH.cmake calls
#   find_package(MEDFile REQUIRED) unconditionally, and FindMEDFile.cmake
#   FATAL_ERRORs with "med.h not found". libmed supplies med.h in
#   ${prefix}/include plus libmedC/libmed, which is exactly what it probes for.
#   Note this is unavoidable even with BUILD_FEM=OFF, because BUILD_MESH_PART
#   also defaults ON and equally forces FREECAD_USE_SMESH -- and MeshPart is
#   wanted anyway (solid->mesh conversion, i.e. STL export for 3D-printed
#   enclosures).
#
# BUILD_TEST / ENABLE_DEVELOPER_TESTS=OFF -- both default ON and add substantial
#   build time to an already very large C++ build.
#
# Bundled third-party code used as-is (all present in the source drop and all
# default to the bundled copy): OndselSolver, salomesmesh, zipios++, PyCXX,
# libE57Format, GSL, json, libkdtree. Do not switch these to
# FREECAD_USE_EXTERNAL_* without adding the matching ports.

# BUILD NOTES / os.major
# ----------------------
# Target is macOS 14+ (Sonoma or later) on x86_64, where the toolchain provides
# a libc++ new enough for FreeCAD's C++ level and MacPorts provides Qt 6.11 +
# PySide6 6.11 (the combination upstream develops against). NO Ventura-style
# libc++ workaround is included here deliberately.
#
# On macOS 13 (Ventura, Darwin 22) expect two extra problems, to be handled
# ${os.major}-conditionally IF this is ever built there:
#   1. Qt is capped at 6.7.3 ("Qt 6.8 is not supported on macOS 13"), so
#      PySide6/Shiboken6 are 6.7.3 -- older than upstream FreeCAD 1.1 targets.
#   2. The Ventura CLT libc++ (15) lacks parts of C++20; if FreeCAD trips on it,
#      apply the same recipe as the kicad/openroad ports in this tree
#      (configure.compiler macports-clang-19 plus -nostdinc++ -isystem
#      ${prefix}/libexec/llvm-19/include/c++/v1).
#
# BOOST: uses the VERSIONED boost181 via the boost PortGroup, NOT the umbrella
# `boost` port. Established by a build failure (2026-08), not by choice:
#   src/App/Transactions.cpp and src/App/DynamicProperty.cpp call .contains() on
#   a Boost.MultiIndex hashed_index. That member does NOT exist in boost 1.76,
#   which is what the umbrella `boost` port installs -- so the compile died with
#   "no member named 'contains' in boost::multi_index::detail::hashed_index<...>".
#   It IS present in 1.81 (and later), verified by grepping the headers.
#   FreeCAD's own BOOST_MIN_VERSION is a stale 1.74 (see
#   CompilerChecksAndSetups.cmake), so find_package(Boost 1.74) HAPPILY accepts
#   1.76 and the failure only surfaces at compile time.
#   1.81 is chosen to match kicad/openroad/openroad-ll, which already pin it.
#   Boost_NO_SYSTEM_PATHS + explicit Boost_DIR/BOOST_ROOT keep the umbrella
#   1.76 headers in ${prefix}/include from shadowing 1.81 -- the same recipe the
#   openroad port uses -- so NO `conflicts_build boost` gate is needed here and
#   the umbrella boost may stay active while this port builds. (kicad DOES need
#   that gate; openroad's own comments disagree with each other about it.)
#
# STATUS: BUILD-VERIFIED on macOS 15.3 (Sequoia, Darwin 24) / Xcode 16.2,
# x86_64, 2026-08. `freecadcmd --version` reports "FreeCAD 1.1.3 Revision:
# 20260725". Four fixes were needed relative to the first draft, each recorded
# above: port:vtk, port:libmed, the COIN3D_*_VERSION override, and boost181
# instead of the umbrella boost. NOTABLY: OpenCASCADE 7.9 needed NO changes --
# the anticipated OCCT API drift did not materialise.

# FreeCAD installs FreeCAD (GUI) and FreeCADCmd (headless, used for scripted
# STEP export) into the private prefix, and expose both under lowercase names on
# PATH. Wrappers rather than symlinks: like ghdl, the binary locates its
# resources relative to its own invocation path.
#
# NOTE the subdirectory is MacOS/, NOT bin/ (verified 2026-08 from the installed
# tree): even with FREECAD_CREATE_MAC_APP=OFF, FreeCAD's macOS install keeps the
# app-bundle-style layout -- libexec/freecad/{MacOS,Ext,Mod,lib,share,include} --
# so the executables land in MacOS/. The binary NAMES are as expected
# (FreeCAD / FreeCADCmd).
set fc_bindir       ${prefix}/libexec/freecad/MacOS
post-destroot {
    xinstall -d ${destroot}${prefix}/bin
    foreach {link target} {freecad FreeCAD freecadcmd FreeCADCmd} {
        set w ${destroot}${prefix}/bin/${link}
        system "printf '%s\\n' '#!/bin/sh' \
            'exec ${fc_bindir}/${target} \"\$@\"' > ${w}"
        file attributes ${w} -permissions 0755
    }
}

livecheck.type      none
