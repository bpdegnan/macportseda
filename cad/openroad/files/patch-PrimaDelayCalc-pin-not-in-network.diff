+// Every driver and load pin must have a node in the conductance system that
+// findNodeCount() just built, because stampEqns(), updateCeffIdrvr() and
+// dcalcResults() index arrays with pin_node_map_ lookups. Neither is
+// guaranteed: findNodeCount() places only the nodes present in the parasitic
+// network, so a driver or load pin missing from the SPEF net (or external) is
+// never placed. Those lookups used operator[],
+// which default-inserts index 0 -- so with no node placed at all (node_count_
+// == 0) the G/B stamps and threshold_times_[0] go out of bounds and the run
+// SIGSEGVs, and otherwise the pin is silently aliased onto node 0. Same
+// failure class as ArnoldiReduce::findPt. Decline instead, exactly as a
+// checkArgs() failure does, and let the table delay calculator take the net.
+bool
+PrimaDelayCalc::netPinsInNetwork()
+{
+  for (size_t drvr_idx = 0; drvr_idx < drvr_count_; drvr_idx++) {
+    ArcDcalcArg &dcalc_arg = (*dcalc_args_)[drvr_idx];
+    if (!pin_node_map_.contains(dcalc_arg.drvrPin())) {
+      failure_reason_ = "driver pin not in parasitic network";
+      failure_arg_ = &dcalc_arg;
+      debugPrint(debug_, "prima", 1, "arg check failed {}.",
+                 failureReason().c_str());
+      return false;
+    }
+  }
+  for (const auto &load_pin_index : *load_pin_index_map_) {
+    if (!pin_node_map_.contains(load_pin_index.first)) {
+      failure_reason_ = "load pin not in parasitic network";
+      failure_arg_ = &(*dcalc_args_)[0];
+      debugPrint(debug_, "prima", 1, "arg check failed {}.",
+                 failureReason().c_str());
+      return false;
+    }
+  }
+  return true;
+}
