# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           eda-github 1.0
PortGroup           select 1.0

name                eda-ngspice47
version             47
revision            1

categories          cad science
license             BSD
maintainers          {icanalytica.com:degnan @bpdegnan} openmaintainer
platforms           macosx

description         ngspice ${version} (versioned private prefix) for the analog flow
long_description    ngspice mixed-level/mixed-signal circuit simulator, version \
                    ${version}, built into its OWN private prefix \
                    ${prefix}/libexec/eda/ngspice${version} so that several \
                    ngspice releases coexist. Newer release, added 2026-08 alongside the validated 46. \
                    Use \
                    'sudo port select --set eda-ngspice eda-ngspice${version}' \
                    to make this the one reached as `eda-ngspice`, and as the \
                    libngspice that this tree's kicad dlopens. Coexists with the \
                    stock MacPorts ngspice port, which keeps ${prefix}/bin/ngspice. \
                    OSDI (OpenVAF compiled Verilog-A) is default-on since 45.

homepage            https://ngspice.sourceforge.io/

distname            ngspice-${version}
# SourceForge MOVES a release into ng-spice-rework/old-releases/<ver>/ once a
# newer one ships, so the plain .../ng-spice-rework/<ver>/ path 404s for anything
# no longer current -- which only a FRESH machine hits (an existing box keeps
# working because the tarball is already cached). List BOTH paths so the fetch
# survives the move in either direction. Use downloads.sourceforge.net: the
# sourceforge.net/projects/.../files/ form is the web UI and 404s for a fetch.
master_sites        https://downloads.sourceforge.net/project/ngspice/ng-spice-rework/old-releases/${version} \
                    https://downloads.sourceforge.net/project/ngspice/ng-spice-rework/${version}
dist_subdir         eda-ngspice

checksums           rmd160  cb8ec53bfd2843677816e2834b71153c0bb15f64 \
                    sha256  894e649651f1838a14095e5a5439e7d3aa63e87ede14d283173fda4fcdef675f \
                    size    13105136

compiler.c_standard   2011
compiler.cxx_standard 2011

# Same two patches as the stock port (targets verified still present in ${version}):
# don't pass -static to the macOS linker (trac 70175), and guard the 10.8 MACH
# task-info renames for old SDKs.
patchfiles-append   patch-fix-linking.diff \
                    patch-ngspice-older-MACH-defines.diff

set edaprefix       ${prefix}/libexec/eda
set myprefix        ${edaprefix}/ngspice${version}

depends_build-append \
                    port:bison \
                    port:flex
depends_lib-append  port:readline \
                    port:libtool \
                    port:xorg-libX11 \
                    port:xorg-libXaw \
                    port:xorg-libXext
# The select symlinks (bin/eda-ngspice and the libexec/eda/lib/... paths) are
# owned by this group's base files, not by this port.
depends_lib-append  port:eda-ngspice_select

# BOTH artifacts come from THIS port, in two separate OUT-OF-TREE builds:
#   build-bin  -> the ngspice executable + XSPICE codemodels
#   build-lib  -> libngspice (--with-ngshared)
# They cannot share one configure run (--with-ngshared builds the library
# INSTEAD of the binary), and they must not share one build directory. Keeping
# them in a single PORT (rather than a port plus a -lib subport, which is how
# this tree did it before) is what lets one select file cover the binary AND the
# library: two subports cannot both install the same ${prefix}/etc/select entry,
# yet kicad needs the library link to follow the selection too.
configure.dir       ${workpath}/build-bin
build.dir           ${configure.dir}
destroot.dir        ${configure.dir}
configure.cmd       ${worksrcpath}/configure
configure.pre_args  --prefix=${myprefix}

# freetype2 headers are not found by default (X11 plotting text)
configure.cppflags-prepend -I${prefix}/include/freetype2
configure.ldflags-append   -L${prefix}/lib

pre-configure {
    file mkdir ${configure.dir}
}

# Stock flag set. OSDI needs no flag (default-on since 45; --disable-osdi opts out).
configure.args      --enable-cider \
                    --enable-xspice \
                    --enable-pss \
                    --disable-openmp \
                    --disable-silent-rules \
                    --with-readline=${prefix} \
                    --with-x

build.args          VERBOSE=1

# Second build: the shared library. --enable-relpath makes libngspice look for
# the XSPICE codemodels RELATIVE to itself; the binary build installs them to
# ${myprefix}/lib/ngspice and the dylib lands in ${myprefix}/lib, so the same
# relative arrangement the previous eda-ngspice-lib subport relied on is kept.
post-build {
    set ldir ${workpath}/build-lib
    file mkdir ${ldir}
    system -W ${ldir} "CC=${configure.cc} \
        CPPFLAGS='-I${prefix}/include -I${prefix}/include/freetype2' \
        LDFLAGS='-L${prefix}/lib' \
        ${worksrcpath}/configure --prefix=${myprefix} \
            --enable-cider --enable-xspice --enable-pss --enable-relpath \
            --disable-openmp --disable-silent-rules \
            --with-readline=${prefix} --with-ngshared && \
        make -j${build.jobs}"
}

post-destroot {
    set ldir ${workpath}/build-lib
    set docdir ${myprefix}/share/doc/ngspice
    xinstall -d ${destroot}${docdir}
    xinstall -m 644 -W ${worksrcpath} \
        ANALYSES AUTHORS BUGS COPYING ChangeLog DEVICES FAQ NEWS README \
        README_OSDI.md Stuarts_Poly_Notes \
        ${destroot}${docdir}

    # Install the shared-library build by hand: upstream's install target is
    # binary-oriented and would clobber the executable build above.
    xinstall -d ${destroot}${myprefix}/lib
    xinstall -m 755 ${ldir}/src/.libs/libngspice.0.dylib ${destroot}${myprefix}/lib
    ln -s libngspice.0.dylib ${destroot}${myprefix}/lib/libngspice.dylib
    xinstall -d ${destroot}${myprefix}/lib/pkgconfig
    xinstall -m 644 ${ldir}/ngspice.pc ${destroot}${myprefix}/lib/pkgconfig
    xinstall -d ${destroot}${myprefix}/include/ngspice
    xinstall -m 644 ${worksrcpath}/src/include/ngspice/sharedspice.h \
        ${destroot}${myprefix}/include/ngspice

    # Always-available versioned command, independent of what is selected --
    # same idea as python3.12/python3.13 sitting beside the python3 select.
    ln -s ${myprefix}/bin/ngspice ${destroot}${prefix}/bin/eda-ngspice${version}
}

select.group        eda-ngspice
select.file         ${filespath}/eda-ngspice${version}

notes "
ngspice ${version} is installed in its own prefix and is always callable as
  eda-ngspice${version}
Nothing else changes until you SELECT it. To make it the tree's active
simulator -- the `eda-ngspice` command AND the libngspice that kicad dlopens:

  sudo port select --set eda-ngspice eda-ngspice${version}
  port select --list eda-ngspice

Switching the selection changes which libngspice kicad loads WITHOUT rebuilding
kicad, so re-check a simulation there after switching.
"

# Batch-mode transient sanity check on the freshly built binary: an RC divider
# must settle to the expected midpoint voltage.
test.run            yes
test.dir            ${build.dir}
test {
    set cir ${workpath}/rc_test_${version}.cir
    set fp [open ${cir} w]
    puts ${fp} "rc divider test"
    puts ${fp} "v1 in 0 dc 2"
    puts ${fp} "r1 in mid 1k"
    puts ${fp} "r2 mid 0 1k"
    puts ${fp} "c1 mid 0 1n"
    puts ${fp} ".control"
    puts ${fp} "tran 1u 100u"
    puts ${fp} "print v(mid)\[length(v(mid))-1\] > ${workpath}/rc_out_${version}.txt"
    puts ${fp} "quit"
    puts ${fp} ".endc"
    puts ${fp} ".end"
    close ${fp}
    system -W ${build.dir} "./src/ngspice -b ${cir} > ${workpath}/rc_run_${version}.log 2>&1"
    set fp [open ${workpath}/rc_out_${version}.txt r]
    set out [read ${fp}]
    close ${fp}
    if {![string match "*1.0*" ${out}]} {
        error "RC divider did not settle to 1.0 V: ${out}"
    }
}

livecheck.type      none
