+// Whether the input stage's net has its other loads: an input port's or a
+// propagated clock's, which the timing loads with them (without them a
+// port's wire simulates faster than it was timed), but not an ideal
+// clock's, whose wires the timing takes as ideal and whose net can reach
+// every register of the design.
+bool
+WritePathSpice::inputStageLoads()
+{
+  const Path *input_path = stageDrvrPath(stageFirst());
+  return !input_path->isClock(this) || input_path->clkInfo(this)->isPropagated();
+}
