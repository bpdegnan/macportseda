configure.args-append \
    -DUSE_QT6=ON \
    -DENABLE_CGAL=ON \
    -DUSE_BUILTIN_OPENCSG=OFF \
    -DUSE_BUILTIN_MANIFOLD=ON \
    -DUSE_BUILTIN_CLIPPER2=ON \
    -DENABLE_TESTS=OFF \
    -DENABLE_GUI_TESTS=OFF \
    -DMANIFOLD_TEST=OFF \
    -DENABLE_GAMEPAD=OFF \
    -DSNAPSHOT=ON \
    -DBoost_DIR=${prefix}/libexec/boost/1.81/lib/cmake/Boost-1.81.0 \
    -DBOOST_ROOT=${prefix}/libexec/boost/1.81 \
    -DBoost_NO_SYSTEM_PATHS=ON \
    -DQT6QSCINTILLA_LIBRARY=${qt6.dir}/lib/libqscintilla2_qt6.dylib \
    -DQT6QSCINTILLA_INCLUDE_DIR=${qt6.dir}/include/Qsci \
    -DOPENGL_gl_LIBRARY=/System/Library/Frameworks/OpenGL.framework \
    -DOPENGL_glu_LIBRARY=/System/Library/Frameworks/OpenGL.framework

# qscintilla-qt6 supplies the script editor widget and is REQUIRED, not optional:
# CMakeLists does find_package(Qt6QScintilla 2.8.0 REQUIRED). Note the stock
# openscad port uses qscintilla-QT5 -- the Qt6 build needs the qt6 flavour.
#
# Installing that port is NOT enough: OpenSCAD's bundled
# cmake/Modules/FindQt6QScintilla.cmake does
#     find_library(QT6QSCINTILLA_LIBRARY NAMES ... qscintilla2_qt6
#                  HINTS ${Qt6Widgets_LIBRARIES})
# and Qt6Widgets_LIBRARIES is a CMake TARGET NAME (Qt6::Widgets), not a path, so
# the hint contributes nothing -- while MacPorts keeps Qt6 under libexec/qt6,
# which is off CMake's default search path. The library really is called
# libqscintilla2_qt6.dylib (a name the module does list), it simply is never
# looked for in the right place, so both paths are supplied explicitly below.
# USE APPLE'S OpenGL, NOT MacPorts mesa -- the same trap eda-coin and eda-freecad
# hit. The cmake PortGroup passes -DCMAKE_FIND_FRAMEWORK=LAST, so with the mesa
# port installed find_package(OpenGL) reports
#     -- Found OpenGL: /opt/local/lib/libGL.dylib
# and the link line gets libGL.dylib but NO -framework OpenGL. That fails at the
# very end (after a 100% compile) because OpenSCAD's macOS offscreen context is
# CGL-based and mesa provides no CGL:
#     ld: Undefined symbols: _CGLChoosePixelFormat, _CGLCreateContext, ...
#       referenced from CreateOffscreenContextCGL(...) in OffscreenContextCGL.cc.o
# Name the framework explicitly, and set ONLY the two *_LIBRARY vars -- adding
# OPENGL_INCLUDE_DIR=<framework>/Headers makes CMake's try_compile fail.
# ENABLE_TESTS defaults ON and would run the (very large) upstream testsuite as
# part of the build; MANIFOLD_TEST likewise defaults ON inside the submodule.
# ENABLE_GAMEPAD is AUTO by default and its Qt5Gamepad driver is unavailable
# under Qt6 -- CMake hard-errors on that combination unless it is OFF.
# Boost lives in a VERSIONED private prefix (libexec/boost/1.81), which CMake's
# find_package(Boost 1.70 REQUIRED COMPONENTS regex program_options) cannot find
# on its own -- hence the explicit Boost_DIR/BOOST_ROOT plus Boost_NO_SYSTEM_PATHS
# so the umbrella `boost` port can never be picked up instead. Same recipe as
# eda-freecad.
# SNAPSHOT=ON matches what this tag is: an upstream dev snapshot, and it selects
# the nightly icon set so the app is visibly distinct from a stable release.

livecheck.type      none
