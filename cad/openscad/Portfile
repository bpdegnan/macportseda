# Drop each submodule archive into the path git would have checked it out at.
post-extract {
    foreach {sha dest src} [list \
            ${manifold_sha}   submodules/manifold         manifold \
            ${clipper2_sha}   submodules/Clipper2         Clipper2 \
            ${sanitizers_sha} submodules/sanitizers-cmake sanitizers-cmake \
            ${mcad_sha}       libraries/MCAD              MCAD] {
        delete ${worksrcpath}/${dest}
        move ${workpath}/${src}-${sha} ${worksrcpath}/${dest}
    }
}

