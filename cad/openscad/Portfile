# Versioned boost, NOT the umbrella `boost` port -- same choice as eda-freecad,
# and it keeps this port clear of the boost-deactivation gate that
# openroad/openroad-ll/kicad need.
PortGroup           boost 1.0
boost.version       1.81

name                openscad
version             2026.01.01
revision            0

categories          cad science
license             GPL-2+
maintainers         {icanalytica.com:degnan @bpdegnan} openmaintainer
platforms           macosx

description         OpenSCAD script-based 3D CAD modeller (current snapshot, CGAL 6)
long_description    OpenSCAD is a script-based solid 3D CAD modeller: geometry \
                    is described in its own language rather than drawn \
                    interactively, which makes it a good companion to FreeCAD \
                    for parametric PCB enclosures. FreeCAD ships an OpenSCAD \
                    workbench that drives this program as an EXTERNAL \
                    EXECUTABLE, so the two interoperate through the binary and \
                    file formats, not through shared libraries.

homepage            https://openscad.org/

# ---- WHY THIS PORT SHADOWS THE STOCK MacPorts openscad --------------------
# The stock port is openscad 2021.01, which is upstream's newest *stable*
# release (Feb 2021 -- their release cadence really is that slow) but it
# requires the OLD **cgal4**, and cgal4 CONFLICTS with the **cgal6** that
# CSXCAD and openEMS pull in. On a machine with this tree's EM chain installed,
# stock openscad simply cannot be installed:
#     Error: Can't install cgal4 because conflicting ports are active: cgal6
# This port pins upstream's own dev snapshot tag instead, which builds against
# modern CGAL and therefore coexists with openEMS. Nothing in MacPorts depends
# on openscad, so shadowing the name is risk-free and means `port install
# openscad` gets the one that actually installs -- same approach this tree takes
# for magic / verilator / openEMS.
#
# VERSION/TAG: upstream tags dev snapshots as openscad-<date>-TESTn. The tag is
# openscad-2026.01.01-TEST2; `version` drops the -TEST2 suffix because a hyphen
# in a MacPorts version is best avoided, and the exact tag is pinned below.
set osc_tag         openscad-2026.01.01-TEST2

# ---- Vendored submodules --------------------------------------------------
# The GitHub source archive does NOT contain git submodules, so each one is
# pinned here as its own checksummed distfile (the same approach the openroad
# port in this tree uses). Pins are the submodule SHAs recorded AT ${osc_tag}.
#
# NOT vendored, because MacPorts already provides them and upstream prefers the
# system copy:
#   * OpenCSG  -- USE_BUILTIN_OPENCSG defaults OFF, so find_package finds ours
#   * mimalloc -- submodules/CMakeLists.txt does find_package(mimalloc QUIET)
#                 first and only falls back to the submodule if that misses
set manifold_sha    b2c6ddd2e33510498a62c89049c83fa70342ddb3
set clipper2_sha    6901921c4be75126d1de60bfd24bd86a61319fd0
set sanitizers_sha  c3dc841af4dbf44669e65b82cb68a575864326bd
set mcad_sha        1ea402208c3127ffb443931e9bb1681c191dacca

master_sites        https://github.com/openscad/openscad/archive/${osc_tag}/:osc \
                    https://github.com/elalish/manifold/archive/${manifold_sha}/:manifold \
                    https://github.com/AngusJohnson/Clipper2/archive/${clipper2_sha}/:clipper2 \
                    https://github.com/arsenm/sanitizers-cmake/archive/${sanitizers_sha}/:sanitizers \
                    https://github.com/openscad/MCAD/archive/${mcad_sha}/:mcad

distname            ${osc_tag}
