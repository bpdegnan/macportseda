# github.setup MUST come before `name`: it sets name from the repo (qucs_s, with
# an underscore) and version from the tag, so the override has to follow it --
# the same ordering the openvaf port in this tree needs.
github.setup        ra3xdh qucs_s 26.1.1
github.tarball_from archive

name                qucs-s
revision            0

categories          science cad
license             GPL-2+
maintainers         {icanalytica.com:degnan @bpdegnan} openmaintainer
platforms           macosx

description         Qucs-S schematic capture front end for SPICE simulators
long_description    Qucs-S is the SPICE fork of Qucs: a graphical schematic \
                    capture program whose purpose is to DRIVE EXTERNAL \
                    SIMULATORS rather than ship its own. It generates netlists \
                    for ngspice, Xyce and SPICE OPUS, runs them, and plots the \
                    results, and it understands Verilog-A device models built \
                    to OSDI by OpenVAF. That makes it a graphical entry path \
                    onto the simulators this tree already builds. It also \
                    bundles the Qucsator RF engine plus a set of RF design \
                    calculators (filter, attenuator, transmission line, power \
                    combining, active filter) and an S-parameter viewer.

homepage            https://ra3xdh.github.io/

# ---- WHY THE PLAIN NAME, AND WHY NOT THE STOCK `qucs` PORT ------------------
# MacPorts ships `qucs` 0.0.20-rc2, which is the ORIGINAL Qucs -- a different
# program with its own built-in simulator (qucsator) and no SPICE back end.
# Qucs-S is a separate upstream (ra3xdh) whose whole reason to exist is driving
# ngspice/Xyce/SPICE OPUS, and it installs under its own name, so the two
# coexist and nothing collides. MacPorts has no `qucs-s` port, so the plain name
# is free -- same reasoning as nec2c / sv2v / ghdl / cvc-rv in this tree.

dist_subdir         qucs-s

# ---- Vendored submodules ---------------------------------------------------
# The GitHub source archive does NOT contain git submodules, so each one is
# pinned here as its own checksummed distfile (same approach as the openroad and
# openscad ports in this tree). Pins are the submodule SHAs recorded AT the
# ${version} tag.
#
# All three are OPTIONAL to the build in the mechanical sense: the top-level
# CMakeLists gates each on `if(EXISTS ${CMAKE_SOURCE_DIR}/<dir>/CMakeLists.txt)`
# and merely prints "submodule not found. Please update submodules" when absent.
# They are vendored anyway so the port is the complete program upstream ships.
#
# SIZE WARNING -- qucs-s-spar-viewer is a 116 MB distfile for ~4 MB of source.
# The bulk is `docs/help/source/sphinx-venv/`, a Python virtualenv (including
# Linux .so files) accidentally committed upstream. None of it is used to build
# or to run. If that is not worth the archive space, delete the spar-viewer
# entries from distfiles/checksums/post-extract below and the build will simply
# skip that one tool; nothing else changes.
set qucsator_sha    3971737dc6e446f8e3262d20e3087fa392299a7a
set rxcalc_sha      8ece6c4876e83771ad65f1b7bdbd938069f95430
set sparview_sha    f231999a5c83125c3fabe36684c84b0207f476ae

master_sites-append \
    https://github.com/ra3xdh/qucsator_rf/archive/${qucsator_sha}/:qucsator \
    https://github.com/arhiv6/rxcalc/archive/${rxcalc_sha}/:rxcalc \
    https://github.com/andresmmera/qucs-s-spar-viewer/archive/${sparview_sha}/:sparview

distfiles-append \
    qucsator_rf-${qucsator_sha}${extract.suffix}:qucsator \
    rxcalc-${rxcalc_sha}${extract.suffix}:rxcalc \
    qucs-s-spar-viewer-${sparview_sha}${extract.suffix}:sparview

checksums           ${distname}${extract.suffix} \
