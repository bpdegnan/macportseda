# Drop each submodule archive into the path git would have checked it out at.
post-extract {
    foreach {sha dest src} [list \
            ${qucsator_sha} qucsator_rf        qucsator_rf \
            ${rxcalc_sha}   rxcalc             rxcalc \
            ${sparview_sha} qucs-s-spar-viewer qucs-s-spar-viewer] {
        delete ${worksrcpath}/${dest}
        move ${workpath}/${src}-${sha} ${worksrcpath}/${dest}
    }
}

# Qt6 components actually requested across the whole tree INCLUDING the vendored
# submodules: Core Gui Widgets PrintSupport Svg Xml LinguistTools. Core/Gui/
# Widgets/PrintSupport/Xml all live in qtbase under Qt6; Svg needs qtsvg;
# LinguistTools (lrelease, for translations/) needs qttools.
qt6.depends_lib-append \
                    qtbase \
                    qtsvg

qt6.depends_build-append \
                    qttools

# Qucsator RF generates its netlist parsers with flex/bison; the macOS system
# copies are too old, same as the OpenSTA port.
#
# TWO MORE TOOLS THAT NO find_package() REVEALS, both inside qucsator_rf and
# both invisible to a dependency scan. qucsator_rf builds a perfect hash of its
# built-in equation/application names in two steps
# (qucsator_rf/src/CMakeLists.txt):
#
#   1. gperfapphash.gph  <- `COMMAND gperfappgen > ...gph && dos2unix ...gph`
#   2. gperfapphash.cpp  <- `COMMAND ${GPERF_TOOL} -I -m 8 ...gph > temp.gperf`
#
# **dos2unix** is the one that actually bites, and macOS does not ship it. The
# build runs to ~87% and then dies with
#     make[2]: *** [qucsator_rf/src/gperfapphash.gph] Error 127
# 127 is "command not found", NOT a compile error -- and the target name points
# at gperf, which is misleading: step 1 never invokes gperf at all. The rule
# pipes through dos2unix unconditionally, with no WIN32 guard, even though the
# generator's output on a Unix host has no CRLFs to strip.
#
# **gperf** (step 2) is a genuine dependency too, via
# `find_program(GPERF_TOOL NAMES gperf ...)`. It happened to be installed here so
# it never failed, but on a machine without it the build would die one step later
# -- and MacPorts hides undeclared dependencies from the build, so having it
# installed is not enough. Declare both and hand CMake the path, as for
# bison/flex.
depends_build-append \
                    port:bison \
                    port:flex \
                    port:gperf \
                    port:dos2unix

configure.args-append \
                    -DBISON_EXECUTABLE=${prefix}/bin/bison \
                    -DFLEX_EXECUTABLE=${prefix}/bin/flex \
                    -DGPERF_TOOL=${prefix}/bin/gperf

# ---- Upstream's two APPLE-only INSTALL(CODE) blocks have to go --------------
# qucs/CMakeLists.txt ends with two `IF(APPLE) INSTALL(CODE "...")` blocks that
# are written for building a REDISTRIBUTABLE self-contained .app, not for
# installing into a package manager's prefix. Both interpolate
# ${CMAKE_INSTALL_PREFIX} directly, and INSTALL(CODE) does NOT get DESTDIR
# prepended, so both address the LIVE /opt/local instead of the destroot:
#
#  1. `file(WRITE "${CMAKE_INSTALL_PREFIX}/bin/<bundle>/Contents/Resources/
#     qt.conf" "")` -- this is what actually killed destroot:
#         CMake Error at qucs/cmake_install.cmake:46 (file):
#           file failed to open for writing (No such file or directory):
#             /opt/local/bin/qucs-s.app/Contents/Resources/qt.conf
#     Removing it rather than DESTDIR-correcting it is deliberate. The file it
#     writes is EMPTY, and an empty qt.conf tells Qt to resolve its prefix
#     RELATIVE TO THE BUNDLE -- so Qt would hunt for plugins inside
#     qucs-s.app instead of ${prefix}/libexec/qt6/plugins and fail to find the
#     Cocoa platform plugin. That is exactly the trap noted in the eda-freecad
#     port ("do NOT copy the skeleton's qt.conf"). We are NOT shipping a
#     self-contained bundle, so no qt.conf is the correct answer.
#
#  2. `include(BundleUtilities)` + `fixup_bundle(...)` -- never reached, because
#     destroot died on (1) first, but it would have been worse: fixup_bundle
#     copies every non-system dependency INTO the bundle and rewrites install
#     names. In a MacPorts destroot that means duplicating the Qt frameworks and
#     assorted ${prefix} dylibs inside qucs-s.app, defeating MacPorts' dependency
#     tracking and rev-upgrade.
#
# The `INSTALL(DIRECTORY ${QT_PLUGINS_DIR}/imageformats ...)` line just above
# them is left alone: it honours DESTDIR, and without a qt.conf Qt never looks
# inside the bundle, so the copied plugins are inert.
# NOTE: this boilerplate is COPY-PASTED into several of the GUI tools, not just
# qucs/ -- at 26.1.1 it is in qucs, qucs-attenuator, qucs-transcalc and the
# vendored qucs-s-spar-viewer. Patching only qucs/ gets you the identical
# destroot failure one tool later (".../qucs-sattenuator.app/.../qt.conf"), so
# this walks every CMakeLists.txt and fixes each copy it finds.
post-patch {
    set pats [list "file(WRITE" "fixup_bundle(" "include(BundleUtilities)"]
    set patched {}
    foreach f [glob -nocomplain -directory ${worksrcpath} \
                   CMakeLists.txt */CMakeLists.txt */*/CMakeLists.txt] {
        set fp [open ${f} r]; set d [read ${fp}]; close ${fp}
        set hit 0
        foreach p ${pats} { if {[string first ${p} ${d}] != -1} { set hit 1 } }
        if {!${hit}} { continue }
        # Only reinplace the patterns this file actually has, so MacPorts does
        # not emit "didn't change anything" warnings for the others.
        if {[string first "file(WRITE" ${d}] != -1} {
            reinplace {s|file(WRITE .*qt\.conf.*|# qt.conf write removed by the macportseda port -- see Portfile|} ${f}
        }
        if {[string first "include(BundleUtilities)" ${d}] != -1} {
            reinplace {s|include(BundleUtilities)|# BundleUtilities removed by the macportseda port|} ${f}
        }
        if {[string first "fixup_bundle(" ${d}] != -1} {
            reinplace {s|fixup_bundle(.*|# fixup_bundle removed by the macportseda port|} ${f}
        }
        lappend patched [string range ${f} [expr {[string length ${worksrcpath}] + 1}] end]
    }
    ui_msg "--->  Neutralised bundle-relative qt.conf / fixup_bundle in: [join ${patched} {, }]"

    # Fail LOUDLY if a future version renames or reshapes these, rather than
    # silently shipping a bundle-relative qt.conf or a fixup_bundle again.
    #
    # Test the CALL syntax, not the bare words: both upstream's own comments
    # ("# install a qt.conf file", "# Use BundleUtilities to ...") and the
    # replacement comments written just above legitimately contain the words
    # qt.conf / fixup_bundle / BundleUtilities, so matching those would fire on
    # a correctly patched file. Asking for "file(WRITE", "fixup_bundle(" and
    # "include(BundleUtilities)" matches only real code.
    foreach f [glob -nocomplain -directory ${worksrcpath} \
                   CMakeLists.txt */CMakeLists.txt */*/CMakeLists.txt] {
        set fp [open ${f} r]; set data [read ${fp}]; close ${fp}
        foreach pat ${pats} {
            if {[string first ${pat} ${data}] != -1} {
                return -code error "${f} still contains '${pat}' after post-patch -- upstream reshaped these blocks; re-check the Portfile comments above"
            }
        }
    }
}

# Upstream's macOS build makes every GUI tool a MACOSX_BUNDLE and installs the
# bundles INTO bin/ (`INSTALL(TARGETS ... BUNDLE DESTINATION bin)`), so you end
# up with .app directories nested inside ${prefix}/bin and no plain commands.
# Relocate them the way the openscad, kicad and eda-freecad ports do: bundle to
# ${applications_dir}, lowercase wrapper on PATH.
#
# Done by GLOB rather than a hardcoded list because the set of bundles depends on
# which submodules are present -- qucs-s, qucs-sfilter, rxcalc and the S-param
# viewer all install this way. Wrappers, not symlinks: an app bundle finds its
# Resources relative to the executable's REAL path, which a symlink breaks (the
# same reason the ghdl and eda-freecad ports use wrappers).
post-destroot {
    xinstall -d ${destroot}${applications_dir}
    foreach app [glob -nocomplain -directory ${destroot}${prefix}/bin *.app] {
        set appname [file tail ${app}]
        set base    [file rootname ${appname}]
        set exes    [glob -nocomplain -directory ${app}/Contents/MacOS *]
        if {[llength ${exes}] == 0} {
            ui_warn "${appname} has no executable in Contents/MacOS; left in bin/"
            continue
        }
        set exe [file tail [lindex ${exes} 0]]
        move ${app} ${destroot}${applications_dir}/${appname}

        set w ${destroot}${prefix}/bin/${base}
        system "printf '%s\\n' '#!/bin/sh' \
            'exec ${applications_dir}/${appname}/Contents/MacOS/${exe} \"\$@\"' > ${w}"
        file attributes ${w} -permissions 0755
    }
}

notes "
Qucs-S is a SCHEMATIC FRONT END, not a simulator: it writes a netlist, runs an
EXTERNAL engine and plots the result. Point it at the engines this tree builds
via Simulation -> Simulator settings:

  ngspice   ${prefix}/bin/ngspice        (from eda-ngspice; `port select
                                          eda-ngspice` chooses 46 vs 47)
  Xyce      ${prefix}/bin/Xyce           (from the xyce port)
  Qucsator  ${prefix}/bin/qucsator_rf    (the bundled RF engine, installed here)

Verilog-A compact models compile to OSDI with this tree's openvaf:
  openvaf-r model.va   ->   model.osdi
and ngspice loads that with `pre_osdi model.osdi`, so Qucs-S drives the same
openvaf -> OSDI -> ngspice chain the tree already verifies.

The GUI tools are installed BOTH ways -- as app bundles in ${applications_dir}
for double-clicking, and as lowercase commands on PATH (qucs-s, and the RF
calculators). The stock MacPorts `qucs` port is the unrelated ORIGINAL Qucs and
can be installed alongside this one.
"

