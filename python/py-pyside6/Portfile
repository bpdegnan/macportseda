# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim: fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           eda-github 1.0
PortGroup           python 1.0
PortGroup           qt6 1.0

# VENDORED SNAPSHOT of the stock MacPorts py-pyside6 PLUS FIVE REAL FIXES.
# Needed here because eda-freecad requires Shiboken6 + PySide6 (FreeCAD's
# find_package(Shiboken6)/find_package(PySide6), see its
# cMake/FreeCAD_Helpers/SetupShibokenAndPyside.cmake) and the stock port cannot
# build on this box:
#
#  1. DESTROOT SYMLINK FIX (the reason the stock port fails outright here):
#     post-destroot symlinks into PySide6/lib/ and shiboken6/lib/, but with
#     PySide6 6.7.3 those `lib` subdirectories are never created, so destroot
#     died with "symlink: .../PySide6/lib/libpyside6.abi3.dylib: no such file
#     or directory". We create the directories first (see post-destroot below).
#
#  2. clang/libLLVM MISMATCH FIX: shiboken's ApiExtractor loads libclang from
#     LLVM_INSTALL_DIR (llvm-${clang_version}) but then EXECUTES whatever
#     `clang++` is first on PATH. With `port select clang` pointing at a
#     different major (mp-clang-19 here) that binary dyld-crashes with
#     "Symbol not found: llvm::RISCVISAInfo::printEnabledExtensions" (present
#     in libLLVM 19, absent in 18) and every module then fails with
#     "'type_traits' file not found" / "Error running ApiExtractor". We prepend
#     the matching llvm bin dir to the build PATH so the port is independent of
#     `port select` (no global select juggling needed).
#
#  3. IMPORTED-TARGET INCLUDE DIRS (in the +extracmakepcfiles variant, at the
#     bottom): the stock reinplaces that try to relocate the include dirs match
#     ${_IMPORT_PREFIX}/<dir>/include, but the real content is
#     ${_IMPORT_PREFIX}/include/<dir> -- the components are REVERSED, so those
#     regexes never fire. The imported targets keep pointing into
#     ${prefix}/include/{shiboken6,PySide6}, which this port never creates, so
#     every CMake consumer (eda-freecad) dies at CONFIGURE time with
#       Imported target "Shiboken6::libshiboken" includes non-existent path
#       "/opt/local/include/shiboken6"
#     Compounding it, the shiboken headers install under
#     shiboken6_GENERATOR/include, not shiboken6/include, so stock's
#     shiboken6.pc includedir is wrong for the same reason.
#
#  4. +addonmodules REMOVED FROM default_variants (see the note at that line).
#     Stock defaults it ON; that drags in qt6-qtwebengine (a full Chromium
#     build) plus ~20 more Qt6 modules, and it silently RE-ARMS on every
#     `port upgrade` because this port's recorded requested-variants are empty
#     (it arrives as an eda-freecad dependency). Typing `-addonmodules` once at
#     install time is NOT enough. FreeCAD needs only the base modules.
#
#  5. SELF-CONFLICT ENABLED (conflicts_build ${subport}): this port cannot be
#     built while a copy of ITSELF is active -- the staging install goes partial
#     and the *_pyi step dies on a missing libshiboken6 dylib. Stock ships the
#     block commented out. See the note at that line.
#
# EXIT PATH -- this fork is meant to be temporary. All five are upstream
# MacPorts bugs (or, for 4/5, upstream choices that are wrong for this tree),
# not tree-specific ones. After any `port sync`, diff this file
# against the stock Portfile (`diff <this> "$(port dir py-pyside6)/Portfile"`,
# using a stock checkout) and DELETE this whole directory if upstream has fixed
# them. Note the fixes may already be unnecessary at PySide6 6.11 on macOS 14+ --
# try stock first on a newer machine before assuming this fork is needed.
name                py-pyside6
revision            5
categories-append   devel aqua

maintainers         {icanalytica.com:degnan @bpdegnan} openmaintainer
license             LGPL
supported_archs     arm64 x86_64

python.pep517       no
universal_variant   no
use_xz              yes

description         Python bindings for the Qt cross-platform application and UI framework
long_description    PySide6 is the official Python module from the Qt for Python project, \
                    which provides access to the complete Qt 6.0+ framework.\
                    \nFor module details see https://doc.qt.io/qtforpython-6/package_details.html
homepage            https://pyside.org/

# Qt 6.8 is not supported on macOS 13 (Darwin 22)
if {[vercmp ${qt6.version} 6.8] >= 0} {
    version 6.11.1
    checksums           rmd160  7017462608f9edb3cc5da47a2e088ef93d236c0d \
                        sha256  6ffd9835bb0dd2c56f061d62f1616bb1707cfc0202b80e3165d6be087f3965e2 \
                        size    17963432

    set clang_version   22
    # Same clang version as for qt6-qtbase
} else {
    version             6.7.3
    checksums           rmd160  38dea392d656b16f4c0ad6b8e0971740f2080805 \
                        sha256  a4c414be013d5051a2d10a9a1151e686488a3172c08a57461ea04b0a0ab74e09 \
                        size    14591496

    set clang_version   18
}
# DELIBERATELY NARROWED to 312 (stock declares 310 311 312 313 314).
#
# This port SHADOWS the stock MacPorts py-pyside6 by name, and stock py-pyside6
# has real consumers at other python versions -- py313-pyside6 is used by
# py313-pyside6-fluent-widgets / -frameless-window, and py314-pyside6 by
# cutter-rizin, ghost-downloader and the same widget ports. Declaring only 312
# means our tree's index contains just py-pyside6 + py312-pyside6, so requests
# for py313-/py314-pyside6 find nothing here and FALL THROUGH to the stock port.
# Those consumers therefore keep using unmodified upstream MacPorts, and since
# each python version installs into its own site-packages there is no file
# conflict between ours and stock.
#
# Keep this at the single version eda-freecad/eda-pivy use (their py_ver). If
# FreeCAD is ever moved to another python, change it here AND there together --
# and check the reverse-dependency list above before widening.
notes "
This port is a VENDORED FORK of the stock MacPorts py-pyside6, narrowed to
python 3.12, carrying five fixes it needs to build and to serve eda-freecad.
See the comment block at the top of the Portfile for what each one is and for
the exit path (delete this fork once upstream MacPorts has fixed them).

It builds WITHOUT .pyi type stubs (--disable-pyi). That is deliberate: the stub
generation step is the one that fails when a copy of this port is already
active, which used to force a `conflicts_build` guard and made
`port upgrade outdated` abort on every revision bump. Nothing reads .pyi files
at run time -- they are editor/type-checker metadata -- and FreeCAD imports
PySide6 rather than type-checking against it.
"

python.versions     312
python.default_version 312

distname            pyside-setup-everywhere-src-${version}
master_sites        https://download.qt.io/official_releases/QtForPython/pyside6/PySide6-${version}-src

if {${name} ne ${subport}} {
    # FIX 5: SELF-CONFLICT, now ENABLED (stock ships this block commented out with
    # "6.10 cannot be built if 6.9 is active ... consider uncommenting").
    #
    # It still applies at 6.11.1, and it is NOT limited to a version change:
    # rebuilding the SAME version fails whenever a copy of this port is active.
    # Proven on 2026-08-04: the very first install succeeded (nothing active),
    # every rebuild afterwards died ~20 minutes in with
    #   ImportError: dlopen(.../shiboken6/Shiboken.abi3.so):
    #   Library not loaded: @rpath/libshiboken6.abi3.6.11.dylib
    # during the *_pyi generation step, because the staging install ends up
    # PARTIAL (Shiboken.abi3.so present, libshiboken6.abi3.*.dylib missing).
    # `sudo port -f deactivate py312-pyside6` before building fixes it outright.
    #
    # With this enabled, MacPorts refuses the build up front with a clear
    # "deactivate it first" message instead of wasting a long build on an
    # inscrutable dyld error. That matters for `port upgrade outdated`, which
    # otherwise hits this every single time this port is upgraded.
    # SUPERSEDED by --disable-pyi (in build.args/destroot.args above).
    # conflicts_build worked, but made this port IMPOSSIBLE TO UPGRADE IN PLACE:
    # an upgrade always has the old copy active, so `port upgrade` stopped with
    # "Please forcibly deactivate the existing copy", and since
    # `port upgrade outdated` aborts on the first failure it took the whole bulk
    # upgrade down with it on every revision bump.
    #
    # The root cause is narrower than "a copy is active": it is specifically the
    # *_pyi target, which sources/pyside6/cmake/Macros/PySideModules.cmake guards
    # with `if(NOT (PYSIDE_IS_CROSS_BUILD OR DISABLE_PYI))`. That target runs
    # generate_pyi.py through the freshly built interpreter, which dlopens
    # libshiboken6 out of the PARTIAL staging install -- hence the dyld error.
    # --disable-pyi skips exactly that target, so an active copy stops mattering
    # and normal upgrades work again.
    #
    # The only loss is .pyi type stubs: editor/type-checker metadata that nothing
    # reads at runtime. This port exists solely as an eda-freecad dependency, and
    # FreeCAD imports PySide6 at runtime rather than type-checking against it.
    # To get the stubs back, drop --disable-pyi and restore
    # `conflicts_build ${subport}` TOGETHER -- not one without the other.

    if {${python.version} >= 313} {
        platforms   {darwin >= 23}
    }

    depends_lib-append \
        port:clang-${clang_version} \
        port:libxml2 \
        port:libxslt \
        port:py${python.version}-numpy

    depends_build-append \
        path:bin/cmake:cmake \
        path:bin/ninja:ninja \
        port:py${python.version}-packaging \
        port:py${python.version}-setuptools

    set essential_modules "Core,Gui,Widgets,Help,Network,Concurrent,DBus,Designer,OpenGL,OpenGLWidgets,PrintSupport,Qml,Quick,QuickControls2,QuickTest,QuickWidgets,Xml,Test,Sql,Svg,SvgWidgets,UiTools"

    build.args-append \
        --qtpaths=${prefix}/libexec/qt6/bin/qtpaths6 \
        --cmake=${prefix}/bin/cmake \
        --parallel=${build.jobs} \
        --disable-pyi \
        --module-subset=${essential_modules}

    # FIX 2 (see header): put the clang matching LLVM_INSTALL_DIR FIRST on PATH.
    # shiboken loads libclang from LLVM_INSTALL_DIR but execs bare `clang++`, so
    # a mismatched `port select clang` otherwise dyld-crashes the ApiExtractor.
    #
    # The prepend is applied unconditionally BUT the dir is the same one stock
    # already guarantees via `depends_build port:clang-${clang_version}`, so it
    # cannot point somewhere that will not exist by build time. Kept as a plain
    # prepend (not an ${os.major} test) so it stays correct on every system: it
    # simply makes the compiler match LLVM_INSTALL_DIR, whatever that resolves to.
    build.env-append \
        LLVM_INSTALL_DIR=${prefix}/libexec/llvm-${clang_version} \
        PATH=${prefix}/libexec/llvm-${clang_version}/bin:${prefix}/bin:${prefix}/sbin:/usr/bin:/bin:/usr/sbin:/sbin
    destroot.env-append \
        LLVM_INSTALL_DIR=${prefix}/libexec/llvm-${clang_version} \
        PATH=${prefix}/libexec/llvm-${clang_version}/bin:${prefix}/bin:${prefix}/sbin:/usr/bin:/bin:/usr/sbin:/sbin

    if {${configure.sdkroot} != ""} {
        build.args-append \
            --macos-sysroot=${configure.sdkroot}
    }

    destroot.args-append \
        --qtpaths=${prefix}/libexec/qt6/bin/qtpaths6 \
        --cmake=${prefix}/bin/cmake \
        --skip-cmake \
        --reuse-build \
        --disable-pyi \
        --module-subset=${essential_modules}

    qt6.depends_lib-append \
        qttools


    variant addonmodules description "Install the addon modules. See https://doc.qt.io/qtforpython-6/package_details.html" {
        build.args-delete --module-subset=${essential_modules}
        destroot.args-delete --module-subset=${essential_modules}

        qt6.depends_lib-append \
            qtlocation \
            qtsensors \
            qtconnectivity \
            qtserialbus \
            qt3d \
            qtwebview \
            qtcharts \
            qtdatavis3d \
            qtvirtualkeyboard \
            qtscxml \
            qtspeech \
            qtnetworkauth \
            qtremoteobjects \
            qtquicktimeline \
            qtquick3dphysics \
            qthttpserver \
            qtquickeffectmaker \
            qtgraphs
    }

    post-destroot {
        # Python 3.14 has trouble extracting IMPORTED_LOCATION even with extra cmake files
        # This is the workaround
        #
        # FIX 1 (see header): PySide6 6.7.3 does not create these `lib`
        # subdirectories, so the symlinks below failed with "no such file or
        # directory" and killed destroot. Create them first. Also symlink the
        # qml lib from its OWN dylib rather than libpyside6's (the stock port
        # points both links at libpyside6.abi3*, which is wrong for the qml one).
        xinstall -d ${destroot}${python.pkgd}/PySide6/lib
        xinstall -d ${destroot}${python.pkgd}/shiboken6/lib
        ln -s ../[file tail {*}[glob ${destroot}${python.pkgd}/PySide6/libpyside6.abi3*.dylib]] ${destroot}${python.pkgd}/PySide6/lib/libpyside6.abi3.dylib
        ln -s ../[file tail {*}[glob ${destroot}${python.pkgd}/PySide6/libpyside6qml.abi3*.dylib]] ${destroot}${python.pkgd}/PySide6/lib/libpyside6qml.abi3.dylib
        ln -s ../[file tail {*}[glob ${destroot}${python.pkgd}/shiboken6/libshiboken6.abi3*.dylib]] ${destroot}${python.pkgd}/shiboken6/lib/libshiboken6.abi3.dylib
    }

    # Global soversion for cmake/pc files variant
    # SOVERSION is major.minor, see ${worksrcpath}/sources/shiboken6/cmake/ShibokenSetup.cmake and search _library_so_version
    set soversion [join [lrange [split $version .] 0 1] .]

    variant extracmakepcfiles description "Install extra .cmake and .pc files to ${prefix}/lib/cmake and ${prefix}/lib/pkgconfig" {
        set python.branch [string index ${python.version} 0].[string range ${python.version} 1 end ]

        post-destroot {
            # manually install and patch .cmake and pkgconfig .pc files
            xinstall -d ${destroot}${prefix}/lib/cmake/
            copy {*}[glob ${worksrcpath}/build/qfp-py${python.branch}-qt${qt6.version}*/install/lib/cmake/*] ${destroot}${prefix}/lib/cmake/
            copy {*}[glob ${worksrcpath}/build/qfp-py${python.branch}-qt${qt6.version}*/install/lib/pkgconfig/*.pc] ${destroot}${prefix}/lib/pkgconfig/
            # All .pc files
            reinplace "s|prefix=.*|prefix=${python.prefix}|g" \
                {*}[glob ${destroot}${prefix}/lib/pkgconfig/*.pc]
            # pyside6.pc
            reinplace "s|includedir=.*|includedir=${python.pkgd}/PySide6/include|g" \
                ${destroot}${prefix}/lib/pkgconfig/pyside6.pc
            reinplace "s|typesystemdir=.*|typesystemdir=${python.pkgd}/PySide6/typesystems|g" \
                ${destroot}${prefix}/lib/pkgconfig/pyside6.pc
            reinplace "s|gluedir=.*|gluedir=${python.pkgd}/PySide6/glue|g" \
                ${destroot}${prefix}/lib/pkgconfig/pyside6.pc
            reinplace "s|libdir=.*|libdir=${python.pkgd}/PySide6|g" \
                ${destroot}${prefix}/lib/pkgconfig/pyside6.pc
            reinplace "s|pythonpath=.*|pythonpath=${python.pkgd}|g" \
                ${destroot}${prefix}/lib/pkgconfig/pyside6.pc
            # shiboken6.pc
            reinplace "s|libdir=.*|libdir=${python.pkgd}/shiboken6|g" \
                ${destroot}${prefix}/lib/pkgconfig/shiboken6.pc
            reinplace "s|includedir=.*|includedir=${python.pkgd}/shiboken6/include|g" \
                ${destroot}${prefix}/lib/pkgconfig/shiboken6.pc
            # All .cmake files
            reinplace "s|${version}\\.dylib|${soversion}.dylib|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/*/*Targets*.cmake]
            reinplace "s|IMPORTED_LOCATION_RELEASE|IMPORTED_LOCATION|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/*/*Targets*.cmake]
            # PySide6 .cmake files
            reinplace "s|\${_IMPORT_PREFIX}/lib|${python.pkgd}/PySide6|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/PySide6*/*Targets*.cmake]
            reinplace "s|\${_IMPORT_PREFIX}/\[a-zA-Z0-9\]\*/include|${python.pkgd}/PySide6/include|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/PySide6*/*Targets*.cmake]
            reinplace "s|PYSIDE_PYTHONPATH \".*\"|PYSIDE_PYTHONPATH \"${python.pkgd}/PySide6\"|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/PySide6*/*Config*.cmake]
            reinplace "s|PYSIDE_TYPESYSTEMS \".*\"|PYSIDE_TYPESYSTEMS \"${python.pkgd}/PySide6/typesystems\"|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/PySide6*/*Config*.cmake]
            reinplace "s|PYSIDE_GLUE \".*\"|PYSIDE_GLUE \"${python.pkgd}/PySide6/glue\"|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/PySide6*/*Config*.cmake]
            # Shiboken6 .cmake files
            reinplace "s|\${_IMPORT_PREFIX}/lib|${python.pkgd}/shiboken6|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/Shiboken6*/*Targets*.cmake]
            reinplace "s|\${_IMPORT_PREFIX}/bin|${python.prefix}/bin|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/Shiboken6*/*Targets*.cmake]
            reinplace "s|\${_IMPORT_PREFIX}/\[a-zA-Z0-9\]\*/include|${python.pkgd}/shiboken6/include|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/Shiboken6*/*Targets*.cmake]
            reinplace "s|SHIBOKEN_PYTHON_MODULE_DIR \".*\"|SHIBOKEN_PYTHON_MODULE_DIR \"${python.pkgd}/shiboken6\"|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/Shiboken6*/*Config*.cmake]
            reinplace "s|SHIBOKEN_SHARED_LIBRARY_DIR \".*\"|SHIBOKEN_SHARED_LIBRARY_DIR \"${python.pkgd}/shiboken6\"|g" \
                {*}[glob ${destroot}${prefix}/lib/cmake/Shiboken6*/*Config*.cmake]

            # ---- FIX 3 (see header): imported-target include dirs ----
            # The two stock reinplaces above that try to rewrite the include dir
            # use the pattern  ${_IMPORT_PREFIX}/<dir>/include  but the real
            # content is  ${_IMPORT_PREFIX}/include/<dir>  -- the components are
            # REVERSED, so those regexes never match anything. The imported
            # targets therefore keep pointing into ${prefix}/include, which this
            # port never populates, and every CMake consumer dies at CONFIGURE
            # time with e.g.
            #   Imported target "Shiboken6::libshiboken" includes non-existent
            #   path "/opt/local/include/shiboken6"
            # On top of that, the shiboken headers are installed under
            # shiboken6_GENERATOR/include, not shiboken6/include -- so the stock
            # shiboken6.pc includedir is wrong for the same reason.
            #
            # DETECTION, NOT ASSUMPTION -- and NEVER FATAL. This port shadows the
            # stock py-pyside6, so it is also what an older machine (e.g. macOS
            # 10.15, where the qt6 portgroup offers Qt 6.4) would build. If the
            # layout there differs and we cannot find the headers, we must leave
            # stock behaviour completely untouched and carry on, rather than
            # failing a build that would otherwise have worked. Locating the
            # header also means this keeps working when upstream moves things
            # between PySide6 versions.
            set sbk_hdr [glob -nocomplain ${destroot}${python.pkgd}/shiboken6*/include/shiboken.h]
            if {[llength ${sbk_hdr}] > 0} {
                set sbk_abs [file dirname [lindex ${sbk_hdr} 0]]
                # strip the destroot prefix -> the path as installed
                set sbk_inc [string range ${sbk_abs} [string length ${destroot}] end]
                reinplace "s|\${_IMPORT_PREFIX}/include/shiboken6|${sbk_inc}|g" \
                    {*}[glob ${destroot}${prefix}/lib/cmake/Shiboken6*/*Targets*.cmake]
                reinplace "s|includedir=.*|includedir=${sbk_inc}|g" \
                    ${destroot}${prefix}/lib/pkgconfig/shiboken6.pc
                ui_msg "${subport}: shiboken6 include dir set to ${sbk_inc}"
            } else {
                ui_warn "${subport}: could not locate shiboken.h under ${python.pkgd}/shiboken6*/include; leaving the stock include paths alone. If a CMake consumer later reports 'Imported target \"Shiboken6::libshiboken\" includes non-existent path', FIX 3 needs updating for this PySide6 version."
            }

            # Same reversed-path defect for PySide6. It did not abort the
            # eda-freecad configure (FreeCAD links the Shiboken6 target), but it
            # is the identical latent bug, so fix it too.
            if {[file isdirectory ${destroot}${python.pkgd}/PySide6/include]} {
                reinplace "s|\${_IMPORT_PREFIX}/include/PySide6|${python.pkgd}/PySide6/include|g" \
                    {*}[glob ${destroot}${prefix}/lib/cmake/PySide6*/*Targets*.cmake]
            }
        }
    }

    variant qtlottie description "Install the Qt Lottie Animation module used with the Bodymovin plugin for Adobe After Effects" {
        qt6.depends_lib-append \
            qtlottie
    }

    variant qt5compat description "Install the Qt5Compat module" {
        qt6.depends_lib-append \
            qt5compat
    }

    # FIX 4: stock has `default_variants +addonmodules +extracmakepcfiles`.
    # +addonmodules is DELIBERATELY DROPPED from the defaults here.
    #
    # Why (found the hard way on 2026-08-04): the registry recorded this port's
    # requested variants as '' (it came in as a dependency of eda-freecad, and a
    # `-addonmodules` on the command line is not recorded as a request). So a
    # plain `port upgrade outdated` re-applied the DEFAULTS, silently turning
    # +addonmodules back ON -- which installed qt6-qtwebengine (a full Chromium
    # build) plus ~20 more Qt6 modules, and then FAILED to build:
    #   ImportError: dlopen(.../shiboken6/Shiboken.abi3.so): Library not loaded:
    #   @rpath/libshiboken6.abi3.6.11.dylib   (during the *_pyi generation step)
    # i.e. the trap re-arms itself on every upgrade and cannot be avoided by
    # remembering to type -addonmodules once.
    #
    # Nothing in this tree wants the addon modules: eda-freecad needs only the
    # base PySide6 modules and sets -DBUILD_WEB=OFF. Anyone who does want them
    # can still ask explicitly with `+addonmodules`.
    default_variants    +extracmakepcfiles
    livecheck.type      none
} else {
    livecheck.type      regex
    livecheck.url       https://download.qt.io/official_releases/QtForPython/pyside6/
    livecheck.regex     (\\d+\\.\\d+\\.\\d+)
}
